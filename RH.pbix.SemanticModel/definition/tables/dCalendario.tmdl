	partition dCalendario = calculated
		mode: import
		source = ```
				
				VAR vAnoMin = YEAR(MIN(Dim_Func[Data Admissão]))
				VAR vAnoMax = YEAR(MAX(Fato_base_func[Data Afastamento]))
				VAR vDataInicial = DATE(vAnoMin, 01, 01)
				VAR vDataFinal = DATE(vAnoMax, 12, 31)
				RETURN
				ADDCOLUMNS( 
				    CALENDAR(
				        vDataInicial,
				        vDataFinal 
				    ),
				    "Ano", YEAR([Date]),
				    "Mês Num", MONTH([Date]),
				    "Mês", FORMAT([Date],"mmm"),
				    "Dia", DAY([Date])    
				)
				```

	annotation PBI_Id = adf8619ef9644368984064e05a7caf60

